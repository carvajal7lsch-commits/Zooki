# PHP lee este archivo con parse_ini_file: en los comentarios no uses parentesis,
# comillas ni el signo igual, porque invalidan el archivo completo.

# Configuración SMTP para envío de correos, por Brevo.
# Login y clave salen de Brevo en SMTP y API, pestaña SMTP.
# El host es el de sendinblue a propósito: con smtp-relay.brevo.com el
# certificado TLS no coincide y PHPMailer corta la conexión.
# El remitente debe ser del dominio autenticado en Brevo.
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=tu_login@smtp-brevo.com
SMTP_PASS=tu_clave_smtp_de_brevo
SMTP_FROM=no-reply@zooki.secarvajal.com

# Prueba local de correos: con MAIL_MODO en archivo no se envía nada; cada correo
# se guarda como .html en logs/correos/, con la fecha, el destinatario y el asunto
# en el nombre del archivo. Solo se respeta con una base local, la misma
# comprobación de scripts/dev/datos_prueba.php; en otro entorno se ignora y queda
# anotado en el log. Comentado, los correos se envían por SMTP como siempre.
# MAIL_MODO=archivo

GOOGLE_CLIENT_ID=tu_google_client_id_aqui

# Configuración de Base de Datos
DB_HOST=db
DB_NAME=zooki_db
DB_USER=zooki_user
DB_PASS=zooki_password
# Clave de root de MySQL, solo la usa docker-compose al crear la base
DB_ROOT_PASS=cambia_esta_clave_de_root

# URL base de la aplicación para enlaces en correos; obligatoria fuera de localhost.
# En local déjalo comentado: los enlaces usan la instalación local desde la que
# se abrió la página. Si apunta a producción, los enlaces de los correos llevan
# a producción.
# APP_URL=https://zooki.secarvajal.com/

# Respaldo automático de la base de datos, HU-23 / RN-504.
# BACKUP_DIR debe apuntar a un volumen o unidad de red FUERA del contenedor de
# la aplicación. Si se deja vacío se usa ./backups, que no cumple el criterio.
# En Docker es la ruta del volumen respaldos de docker-compose.yml.
# BACKUP_DIR=/var/backups/zooki
BACKUP_RETENCION_DIAS=7

# Proxies inversos de confianza, separados por comas: IP exactas o rangos CIDR.
# Solo si la conexión llega desde uno de ellos se lee X-Forwarded-For; si no,
# vale la IP de la conexión, que no es falsificable. Esa IP real la usan la
# auditoría, los límites de intentos de RN-G15 y Turnstile.
# La cadena se recorre de derecha a izquierda y vale la primera IP que no sea
# un proxy confiable: la de la izquierda la puede escribir el cliente.
# Etapa F, Dokploy con Traefik: las peticiones llegan desde la red Docker de
# Traefik, cuya IP cambia al recrear el contenedor. Usar el rango de esa red,
# por ejemplo 10.0.0.0/8 o 172.16.0.0/12; se consulta con
# docker network inspect dokploy-network.
# Déjalo vacío en local, donde no hay proxy.
TRUSTED_PROXIES=

# Buscador Algolia del portal de documentación, opcional.
# Si se dejan vacías, el portal usa su buscador local integrado.
# Se obtienen en https://dashboard.algolia.com/ > Settings > API Keys
ALGOLIA_APP_ID=
# Llave de SOLO BÚSQUEDA: se expone en el navegador, es segura para el frontend
ALGOLIA_SEARCH_KEY=
# Llave de ADMINISTRACIÓN: solo la usa scripts/algolia_index.php. NUNCA
# debe exponerse en el frontend ni subirse al repositorio.
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX_NAME=zooki_docs

# Turnstile: claves públicas de prueba de Cloudflare que siempre aprueban.
# Sustituir ambas por las del dominio antes de producción.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
