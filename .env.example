# PHP lee este archivo con parse_ini_file: en los comentarios no uses parentesis,
# comillas ni el signo igual, porque invalidan el archivo completo.

# Configuración SMTP para envío de correos, por Brevo.
# Login y clave salen de Brevo en SMTP y API, pestaña SMTP.
# El host es el de sendinblue a propósito: con smtp-relay.brevo.com el
# certificado TLS no coincide y PHPMailer corta la conexión.
# El remitente debe ser del dominio autenticado en Brevo.
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=tu_login@smtp-brevo.com
SMTP_PASS=tu_clave_smtp_de_brevo
SMTP_FROM=no-reply@zooki.secarvajal.com

GOOGLE_CLIENT_ID=tu_google_client_id_aqui

# Configuración de Base de Datos
DB_HOST=db
DB_NAME=zooki_db
DB_USER=zooki_user
DB_PASS=zooki_password

# URL base de la aplicación, usada para enlaces en los correos
# APP_URL=https://zooki.secarvajal.com/

# Respaldo automático de la base de datos, HU-23 / RN-504.
# BACKUP_DIR debe apuntar a un volumen o unidad de red FUERA del servidor de
# aplicación. Si se deja vacío se usa ./backups, que no cumple el criterio.
# BACKUP_DIR=/mnt/respaldos/zooki
BACKUP_RETENCION_DIAS=7

# Proxies inversos de confianza, separados por comas. Solo desde estas IPs se
# acepta la cabecera X-Forwarded-For al registrar la IP en auditoría; en
# cualquier otro caso se usa la IP de la conexión, que no es falsificable.
# Déjalo vacío si la aplicación no está detrás de un proxy.
TRUSTED_PROXIES=

# Buscador Algolia del portal de documentación, opcional.
# Si se dejan vacías, el portal usa su buscador local integrado.
# Se obtienen en https://dashboard.algolia.com/ > Settings > API Keys
ALGOLIA_APP_ID=
# Llave de SOLO BÚSQUEDA: se expone en el navegador, es segura para el frontend
ALGOLIA_SEARCH_KEY=
# Llave de ADMINISTRACIÓN: solo la usa scripts/algolia_index.php. NUNCA
# debe exponerse en el frontend ni subirse al repositorio.
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX_NAME=zooki_docs