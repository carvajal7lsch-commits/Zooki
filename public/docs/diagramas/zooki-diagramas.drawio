        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n  A([Agendar cita]) --&gt; ROL{Quien agenda?}\n  ROL -- Propietario (su portal) --&gt; P1[Elige su mascota; describe motivo y sintomas]\n  ROL -- Veterinario (agenda de la clinica) --&gt; V1[Elige mascota; registra motivo y sintomas]\n  P1 --&gt; LIM\n  V1 --&gt; LIM\n \n  LIM{La clinica esta dentro del limite del plan?}\n  LIM -- \&quot;No (agenda el propietario)\&quot; --&gt; LIM1[/\&quot;Mensaje neutral: no es posible agendar en linea ahora\&quot;/]\n  LIM1 --&gt; LIM2[Notificar a la clinica para que lo gestione]\n  LIM2 --&gt; ZF([Fin])\n  LIM -- \&quot;No (agenda el veterinario)\&quot; --&gt; LIM3[/\&quot;Mensaje: limite del plan alcanzado, mejora el plan\&quot;/]\n  LIM3 --&gt; ZF\n  LIM -- Si --&gt; G1[Grafo I evalua los sintomas y calcula el nivel de triage]\n \n  G1 --&gt; TRI{Nivel de triage?}\n  TRI -- \&quot;Rojo (critico)\&quot; --&gt; R1[/\&quot;Aviso: caso critico, no se agenda en linea\&quot;/]\n  R1 --&gt; R2[Notificar a la clinica de inmediato y derivar]\n  R2 --&gt; RSUB[[\&quot;Sub-flujo: Atencion de urgencia (2c)\&quot;]]\n  RSUB --&gt; ZF\n \n  TRI -- \&quot;Naranja / Amarillo / Verde\&quot; --&gt; DISP[\&quot;Calcular disponibilidad:&lt;br/&gt;horario clinica ∩ horario del veterinario − ausencias,&lt;br/&gt;por duracion + margen segun el tipo de cita\&quot;]\n  DISP --&gt; MODO{Como se asigna el espacio?}\n  MODO -- \&quot;Naranja (urgente): sobrecupo\&quot; --&gt; N1[El sistema ubica por sobrecupo sobre el proximo bloque del vet adecuado]\n  MODO -- \&quot;Amarillo (prioritario): primer espacio\&quot; --&gt; Y1[El sistema toma el primer espacio disponible priorizado]\n  MODO -- \&quot;Verde (no urgente): eleccion\&quot; --&gt; VE0{Hay espacios en el rango pedido?}\n  VE0 -- No --&gt; VE0a[/\&quot;Mensaje: no hay espacios, elige otra fecha o rango\&quot;/]\n  VE0a --&gt; VE0b[El actor elige otro rango]\n  VE0b --&gt; DISP\n  VE0 -- Si --&gt; VE1[Mostrar espacios disponibles]\n  VE1 --&gt; SEL[El actor selecciona un espacio]\n \n  N1 --&gt; CRE\n  Y1 --&gt; CONF\n  SEL --&gt; CONF\n \n  CONF{El espacio sigue libre al confirmar?}\n  CONF -- \&quot;No (verde: eleccion manual)\&quot; --&gt; CONF1[/\&quot;Mensaje: ese espacio se acaba de ocupar\&quot;/]\n  CONF1 --&gt; SEL\n  CONF -- \&quot;No (amarillo: primer espacio)\&quot; --&gt; CONF2[Recalcular y tomar el siguiente espacio]\n  CONF2 --&gt; CONF\n  CONF -- Si --&gt; CRE[Crear la cita con tipo, duracion, margen y prioridad]\n  CRE --&gt; AUD[Registrar en auditoria; notificar al propietario y al veterinario]\n  AUD --&gt; ZF&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CHF4t5wJJ1mvsj6XYKab-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
